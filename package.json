{
  "name": "acervo-filarmonica",
  "version": "3.1.0",
  "type": "module",
  "description": "Acervo Digital da Sociedade Filarmônica 25 de Março",
  "main": "worker/src/index.js",
  "scripts": {
    "api": "wrangler dev",
    "api:local": "wrangler dev --local",
    "db:init": "npm run db:migrate:local && npm run db:seed",
    "db:seed": "wrangler d1 execute acervo-db --local --file=database/seed-local.sql",
    "db:reset": "wrangler d1 execute DB --local --file=database/reset-local.sql && npm run db:seed",
    "dev": "node scripts/dev.cjs",
    "dev:prod": "node scripts/dev.cjs prod",
    "dev:worker": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy frontend --project-name=acervo-filarmonica",
    "setup": "node scripts/setup.cjs",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:schema:test": "node scripts/generate-test-schema.cjs --check",
    "db:schema:generate": "node scripts/generate-test-schema.cjs",
    "api:contract:check": "node scripts/check-route-contract.cjs",
    "api:types:check": "npm run generate:api --prefix frontend && git diff --exit-code -- frontend/src/api-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "lint:worker": "eslint worker/ --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acssjr/acervo-filarmonica.git"
  },
  "keywords": [
    "filarmonica",
    "partituras",
    "musica",
    "banda"
  ],
  "author": "Antônio Júnior <acssjr@github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/acssjr/acervo-filarmonica/issues"
  },
  "homepage": "https://github.com/acssjr/acervo-filarmonica#readme",
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "posthog-node": "^5.26.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "3.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "vitest": "3.2",
    "wrangler": "^4.65.0"
  }
}
